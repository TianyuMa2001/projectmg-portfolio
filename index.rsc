1:["$","main",null,{"children":[["$","header",null,{"children":[["$","a",null,{"href":"#top","className":"identity","children":["Tianyu Ma ",["$","span",null,{"children":"Technical Designer"}]]}],["$","nav",null,{"aria-label":"Case study","children":[["$","a",null,{"href":"#key","children":"Progression"}],["$","a",null,{"href":"#fog","children":"Navigation"}],["$","a",null,{"href":"#risk","children":"Risk"}],["$","a",null,{"href":"#release","children":"Downloads"}]]}]]}],["$","section",null,{"className":"hero","id":"top","children":[["$","div",null,{"className":"eyebrow","children":"UNITY / C# / TEAM COURSE PROJECT"}],["$","h1",null,{"children":["ProjectMG",["$","span",null,{"children":["Procedural Exploration",["$","br",null,{}],"and Gameplay Navigation"]}]]}],["$","p",null,{"className":"intro","children":["Give exploration a purpose.",["$","br",null,{}],"Make navigation earn its knowledge."]}],["$","div",null,{"className":"links","children":[["$","a",null,{"className":"primary","href":"/projectmg-portfolio/ProjectMG-case-study.pdf","download":true,"children":"Read the 6-page case study ↗"}],["$","a",null,{"href":"https://github.com/HachimiGame/ProjectMG","children":"Inspect source ↗"}]]}],["$","figure",null,{"className":"flow","children":[["$","img",null,{"src":"/projectmg-portfolio/progression.svg","alt":"Spawn, explore frontier, acquire key, reach exit"}],["$","figcaption",null,{"children":"Designed progression loop · logic diagram, not a gameplay screenshot"}]]}]]}],["$","section",null,{"id":"overview","className":"case","children":[["$","aside",null,{"children":[["$","span",null,{"className":"number","children":"01"}],["$","p",null,{"children":"ProjectMG - Procedural Exploration and Gameplay Navigation"}]]}],["$","article",null,{"children":[["$","h2",null,{"children":"An exploration problem, not an algorithm showcase"}],["$","figure",null,{"children":[["$","img",null,{"src":"/projectmg-portfolio/gameplay.png","alt":"Actual Unity camera rendering of the player and radial fog using abstract replacement visuals"}],["$","figcaption",null,{"children":"Actual Unity camera render · original abstract replacement visuals · screen-overlay HUD is outside this camera capture."}]]}],["$","p",null,{"children":"I designed and implemented systems that connect procedural space to player decisions: explore to find a key, manage damage and supplies, then reach an exit. My navigation work asks a second question: what should an assistant know when the player has not discovered the level?"}],["$","p",null,{"children":"ProjectMG is a team course project built in C# and Unity 6.3 LTS. My work is credited through the hm2mty commits linked below. I extended the team's map/model framework and original visual fog; I did not create the team's artwork or claim the original fog renderer, exit framework, scoring, or difficulty scaling as my own."}],["$","p",null,{"children":"My contributions: room roles and key/chest/monster interactions; connecting fog state to navigation and minimap entity queries; Explore/SeekExit state logic; room-level Dijkstra and tile-level A* with danger costs and bounded healing detours; Delaunay/Kruskal generation; eight-direction input, animation timing and wall-corner repairs."}],["$","p",null,{"children":"This case study distinguishes historical contributions, the team's later changes, and portfolio verification added in September 2026. Code-level checks support implementation claims; they are not evidence of a formal player study."}],["$","div",null,{"className":"evidence","children":[["$","a",null,{"href":"https://github.com/HachimiGame/ProjectMG/commit/51baef8","children":[["$","code",null,{"children":"51baef8"}]," Room gameplay and fog-aware icons ↗"]}],["$","a",null,{"href":"https://github.com/HachimiGame/ProjectMG/commit/3051731","children":[["$","code",null,{"children":"3051731"}]," Frontier exploration and fog-aware phases ↗"]}],["$","a",null,{"href":"https://github.com/HachimiGame/ProjectMG/commit/784c3a6","children":[["$","code",null,{"children":"784c3a6"}]," Delaunay/Kruskal generation ↗"]}],["$","a",null,{"href":"https://github.com/HachimiGame/ProjectMG/commit/68677d4","children":["$Ld"," Efficient exploration and corridor safety ↗"]}]]}]]}]]}],"$Le","$Lf","$L10","$L11","$L12","$L13"]}]
