e:["$","p",null,{"className":"release-status","children":"Random and grouped results are means across seeds 42/43/44. Time validation is one latest-year holdout. Three fixed splits are stability checks, not independent confidence intervals."}]
f:["$","figure",null,{"children":[["$","img",null,{"src":"/projectmg-portfolio/house-model-comparison.png","alt":"Recorded dollar RMSE chart comparing models, validation splits and assessor-estimate inclusion"}],["$","figcaption",null,{"children":"Existing evaluation output from the project repository. The table above isolates the with-estimates comparison."}]]}]
10:["$","p",null,{"children":"HistGB performs best on unseen-property holdouts, but Ridge performs better on the later-year holdout. I therefore distinguish a strong course-dataset result from a recommendation for future-year deployment."}]
11:["$","div",null,{"className":"evidence","children":[["$","a",null,{"href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction/blob/main/artifacts/metrics_summary.csv","children":"Recorded aggregate metrics ↗"}],["$","a",null,{"href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction/blob/main/artifacts/run_metadata.json","children":"Experiment metadata ↗"}]]}]
12:["$","section",null,{"className":"case","children":[["$","aside",null,{"children":["$","span",null,{"className":"number","children":"03"}]}],["$","article",null,{"children":[["$","h2",null,{"children":"Feature usefulness is not feature availability"}],[["$","p",null,{"children":"Removing assessor estimates raises grouped HistGB RMSE from $67,116 to $68,366. This shows their contribution in this experiment; it does not prove those values were available before every sale."}],["$","p",null,{"children":["The retrospective ",["$","code",null,{"children":"Most Recent Sale"}]," flag may also depend on information unavailable at prediction time. Neither time validation nor the no-estimates ablation resolves that issue. An as-of feature audit is needed before prospective use."]}],["$","p",null,{"children":"HistGB preserves ordinal category encoding from the original baseline, which introduces arbitrary ordering for nominal categories. Ridge uses one-hot categories and scaled numeric inputs. Error analysis and these limitations are documented alongside the results."}],["$","a",null,{"href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction/blob/main/IMPROVEMENT_REPORT.md","children":"Read the evaluation report ↗"}]]]}]]}]
13:["$","section",null,{"className":"case","children":[["$","aside",null,{"children":["$","span",null,{"className":"number","children":"04"}]}],["$","article",null,{"children":[["$","h2",null,{"children":"Reproduce the work"}],[["$","p",null,{"children":"The code repository includes pinned dependencies, a training entry point, evaluation scripts and compact aggregate evidence. Six recorded tests cover split isolation, temporal purging, input contracts, nonmutating features, missing or unseen values, serialization and target/metric validity."}],["$","p",null,{"children":"Supply the course CSVs separately, install the dependencies, and run the commands in the README. Datasets, fitted models and row-level predictions are not redistributed with this page."}],["$","p",null,{"children":"The unlabeled downloaded test data has not been verified as the original grading set. I make no official contest score, ranking, fairness or online deployment claim."}],["$","div",null,{"className":"links","children":[["$","a",null,{"href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction/blob/main/README.md","children":"Setup & reproduction ↗"}],["$","a",null,{"href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction/blob/main/test_pipeline.py","children":"Pipeline tests ↗"}]]}]]]}]]}]
