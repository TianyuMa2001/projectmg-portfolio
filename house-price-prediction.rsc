1:["$","main",null,{"className":"compact","children":[["$","header",null,{"children":[["$","a",null,{"className":"identity","href":"/projectmg-portfolio/portfolio/","children":["Tianyu Ma",["$","span",null,{"children":"Technical Designer"}]]}],["$","nav",null,{"aria-label":"Projects","children":[["$","a",null,{"href":"/projectmg-portfolio/portfolio/","children":"All projects"}],["$","a",null,{"href":"https://tianyuma2001.github.io/projectmg-portfolio/","children":"ProjectMG"}],["$","a",null,{"href":"https://github.com/TianyuMa2001","children":"GitHub ↗"}]]}]]}],["$","section",null,{"className":"compact-hero","children":[["$","p",null,{"className":"eyebrow","children":"MACHINE LEARNING / PYTHON / SCIKIT-LEARN"}],["$","h1",null,{"children":"House Price Prediction"}],["$","p",null,{"className":"intro","children":"Evaluating what a housing-price model can generalize to, beyond a single random-split score."}],["$","div",null,{"className":"links","children":[["$","a",null,{"className":"primary","href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction","children":"View source ↗"}],["$","a",null,{"href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction/blob/main/README.md","children":"Run instructions ↗"}]]}]]}],[["$","section",null,{"className":"case","children":[["$","aside",null,{"children":["$","span",null,{"className":"number","children":"01"}]}],["$","article",null,{"children":[["$","h2",null,{"children":"From prediction to defensible validation"}],[["$","p",null,{"children":"I developed and refined a Cook County housing-price pipeline with feature engineering, preprocessing, model training and prediction export. The target is natural-log sale price; reported dollar RMSE is evaluated after transforming predictions back to prices."}],["$","p",null,{"children":"My implementation compares a median baseline, Ridge regression and histogram gradient boosting. I added property-grouped and purged time holdouts, assessor-estimate ablation, quality checks, residual analysis and six automated pipeline tests."}],["$","div",null,{"className":"system-flow","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Valid sales"}],["$","span",null,{"children":"Filter prices below $500"}]]}],["$","b",null,{"aria-hidden":"true","children":"→"}],["$","div",null,{"children":[["$","strong",null,{"children":"Features & pipeline"}],["$","span",null,{"children":"Train-only preprocessing"}]]}],["$","b",null,{"aria-hidden":"true","children":"→"}],["$","div",null,{"children":[["$","strong",null,{"children":"Three validations"}],["$","span",null,{"children":"Random · PIN group · time"}]]}]]}],["$","div",null,{"className":"evidence","children":[["$","a",null,{"href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction/blob/main/proj.py","children":"Feature and model pipeline ↗"}],["$","a",null,{"href":"https://github.com/TianyuMa2001/projectmg-portfolio/house-price-prediction/blob/main/evaluate.py","children":"Evaluation implementation ↗"}]]}]]]}]]}],["$","section",null,{"className":"case","children":[["$","aside",null,{"children":["$","span",null,{"className":"number","children":"02"}]}],["$","article",null,{"children":[["$","h2",null,{"children":"The split changes the conclusion"}],[["$","p",null,{"children":"A random holdout may contain properties also present in training. Grouping by property identifier (PIN) tests unseen properties. The 2019 holdout removes overlapping PINs from earlier training years and asks a different question: how well does the model transfer forward in time?"}],["$","div",null,{"className":"table-scroll","children":["$","table",null,{"className":"results-table","children":[["$","caption",null,{"children":"Dollar RMSE · models with assessor estimates · lower is better"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":"Validation"}],["$","th",null,{"scope":"col","children":"Median"}],["$","th",null,{"scope":"col","children":"Ridge"}],["$","th",null,{"scope":"col","children":"HistGB"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Random holdouts"}],["$","td",null,{"children":"$$164,301"}],["$","td",null,{"children":"$$74,103"}],["$","td",null,{"children":"$$67,208"}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Unseen properties"}],["$","td",null,{"children":"$$163,923"}],["$","td",null,{"children":"$$73,590"}],["$","td",null,{"children":"$$67,116"}]]}],"$Ld"]}]]}]}],"$Le","$Lf","$L10","$L11"]]}]]}],"$L12","$L13"],"$L14"]}]
