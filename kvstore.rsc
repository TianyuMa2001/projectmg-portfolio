1:["$","main",null,{"className":"compact","children":[["$","header",null,{"children":[["$","a",null,{"className":"identity","href":"/projectmg-portfolio/portfolio/","children":["Tianyu Ma",["$","span",null,{"children":"Technical Designer"}]]}],["$","nav",null,{"aria-label":"Projects","children":[["$","a",null,{"href":"/projectmg-portfolio/portfolio/","children":"All projects"}],["$","a",null,{"href":"https://tianyuma2001.github.io/projectmg-portfolio/","children":"ProjectMG"}],["$","a",null,{"href":"https://github.com/TianyuMa2001","children":"GitHub ↗"}]]}]]}],["$","section",null,{"className":"compact-hero","children":[["$","p",null,{"className":"eyebrow","children":"DISTRIBUTED SYSTEMS / JAVA / SPRING BOOT"}],["$","h1",null,{"children":"KV Store"}],["$","p",null,{"className":"intro","children":"Making replication, quorum trade-offs and uncertain write outcomes visible in a five-node prototype."}],["$","div",null,{"className":"links","children":[["$","a",null,{"className":"primary","href":"https://github.com/TianyuMa2001/KV-Store","children":"View source ↗"}],["$","a",null,{"href":"https://github.com/TianyuMa2001/KV-Store/blob/main/README.md","children":"Run instructions ↗"}]]}]]}],[["$","section",null,{"className":"case","children":[["$","aside",null,{"children":["$","span",null,{"className":"number","children":"01"}]}],["$","article",null,{"children":[["$","h2",null,{"children":"The problem and my implementation"}],[["$","p",null,{"children":"A replicated store must decide when a write is acknowledged, which version a read returns, and what a timeout actually means. I implemented and refined a single-leader, in-memory store with configurable write quorum W and read quorum R."}],["$","p",null,{"children":"My work covers atomic per-key version allocation, parallel replication and peer reads, monotonic follower updates, explicit timeout responses, configuration validation, and reproducible correctness and fault checks."}],["$","div",null,{"className":"metrics","children":[["$","div",null,{"children":[["$","strong",null,{"children":"5 nodes"}],["$","span",null,{"children":"1 leader + 4 followers"}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"W / R"}],["$","span",null,{"children":"Configurable quorum sizes"}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"Java 17"}],["$","span",null,{"children":"Spring Boot HTTP API"}]]}]]}],["$","div",null,{"className":"system-flow","aria-label":"Write replication flow","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Client write"}],["$","span",null,{"children":"PUT /kv"}]]}],["$","b",null,{"aria-hidden":"true","children":"→"}],["$","div",null,{"children":[["$","strong",null,{"children":"Leader"}],["$","span",null,{"children":"Allocate version + install locally"}]]}],["$","b",null,{"aria-hidden":"true","children":"→"}],["$","div",null,{"children":[["$","strong",null,{"children":"Four followers"}],["$","span",null,{"children":"Parallel fan-out · acknowledge W"}]]}]]}],["$","p",null,{"className":"release-status","children":"Architecture diagram, not a running cluster screenshot. Docker Compose defaults to W=3 and R=3."}]]]}]]}],["$","section",null,{"className":"case","children":[["$","aside",null,{"children":["$","span",null,{"className":"number","children":"02"}]}],["$","article",null,{"children":[["$","h2",null,{"children":"A timeout is an uncertain outcome"}],[["$","p",null,{"children":"The leader installs its local value before replication reaches quorum. If the deadline expires, responding as though nothing happened would mislead a client: a local write exists, and submitted replication may still finish."}],["$","p",null,{"children":["The API returns HTTP 503 with ",["$","code",null,{"children":"status=indeterminate"}]," and ",["$","code",null,{"children":"localApplied=true"}],". Successful writes return 201 after W acknowledgements, including the leader. A bounded executor submits replication to all followers even when W=1."]}],["$","p",null,{"children":"Followers reject conflicting same-version values and prevent older versions from overwriting newer ones. Quorum reads count reachable missing-key responses and select the highest version among collected responses."}],["$","div",null,{"className":"evidence","children":[["$","a",null,{"href":"https://github.com/TianyuMa2001/KV-Store/blob/main/node/src/main/java/com/kv/node/KvController.java","children":"Read/write implementation ↗"}],"$Ld"]}]]]}]]}],"$Le","$Lf"],"$L10"]}]
