e:["$","section",null,{"className":"case","children":[["$","aside",null,{"children":["$","span",null,{"className":"number","children":"03"}]}],["$","article",null,{"children":[["$","h2",null,{"children":"Verification and an important correction"}],[["$","p",null,{"children":"The recorded Java suite passed 10 tests covering concurrency, replication ordering, slow or unreachable peers, partial writes, reads, invalid inputs and application startup. The benchmark harness additionally checks the build hash, server PID, effective quorum settings and actual port unreachability."}],["$","p",null,{"children":"An earlier benchmark terminated a Java launcher without proving the replica server was down. I withdrew that evidence and the associated 46.2% throughput uplift claim. This page makes no performance improvement claim from those results."}],["$","p",null,{"children":"The corrected local quorum regression verified a five-node W=5 configuration with one replica stopped: all 186 measured writes across three runs returned 503, with no 201 responses. This is a focused failure-semantics check, not a complete throughput benchmark. Since no writes were acknowledged, stale-read rate is not calculable for that case."}],["$","div",null,{"className":"evidence","children":[["$","a",null,{"href":"/projectmg-portfolio/kv-quorum-validation.json","children":"Local regression validation ↗"}],["$","a",null,{"href":"/projectmg-portfolio/kv-quorum-results.csv","children":"Per-run results ↗"}],["$","a",null,{"href":"https://github.com/TianyuMa2001/KV-Store/blob/main/benchmark.py","children":"Public benchmark harness ↗"}]]}],["$","p",null,{"className":"release-status","children":"The two linked evidence files are local verification outputs published with this case study; they are not presented as an already-published GitHub benchmark directory."}]]]}]]}]
f:["$","section",null,{"className":"case","children":[["$","aside",null,{"children":["$","span",null,{"className":"number","children":"04"}]}],["$","article",null,{"children":[["$","h2",null,{"children":"Run it and understand the boundary"}],[["$","p",null,{"children":"Build the JAR with the included Maven wrapper, then start the five-node cluster using Docker Compose. The repository README includes configuration, port mappings, and example read/write requests."}],["$","p",null,{"children":"This is an educational single-leader prototype. Storage is volatile; there is no automatic leader election, durable log, persistent retry queue or consensus protocol. Quorum overlap alone does not establish production-grade linearizability under arbitrary partitions."}],["$","div",null,{"className":"links","children":[["$","a",null,{"href":"https://github.com/TianyuMa2001/KV-Store/blob/main/README.md","children":"Setup & HTTP examples ↗"}],["$","a",null,{"href":"https://github.com/TianyuMa2001/KV-Store/blob/main/IMPROVEMENT_REPORT.md","children":"Implementation and evidence report ↗"}]]}]]]}]]}]
